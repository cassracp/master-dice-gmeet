{
  "manifest_version": 3,
  "name": "Master Dice for Google Meet",
  "version": "1.0.1",
  "description": "Dice Roller and GM Assistant for Google Meet.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["jsdice-core.js", "conteudo.js"],
      "run_at": "document_idle"
    }
  ]
}
